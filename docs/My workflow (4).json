    {
      "parameters": {
        "jsCode": "// 1. Get context from input 1 (from \"Get Item by Index\")\nconst context = $input.all()[1].json;\nconst index = context.index ?? 0;\nconst query = context.query ?? \"Unknown\";\nconst results = context.results ?? [];\n\n// 2. Get API response from input 0 (Google Maps API Text Search)\nconst apiResponse = $input.all()[0].json;\n\n// 3. Extract only place_id's from response\nconst places = apiResponse.results || [];\nconst placeIds = places.map(place => ({\n  place_id: place.place_id\n}));\n\n// 4. Add result with query and placeIds\nconst resultEntry = {\n  query,\n  placeIds\n};\n\n// 5. If next page token exists, include it\nif (apiResponse.next_page_token) {\n  resultEntry.next_page_token = apiResponse.next_page_token;\n}\n\n// 6. Push result into results array\nresults.push(resultEntry);\n\n// 7. Return updated output\nreturn [\n  {\n    json: {\n      index: index + 1,\n      query: null,\n      results\n    }\n  }\n];\n"
      },
