      "parameters": {
        "jsCode": "// Get input context and API response\nconst inputs = $input.all();\nconst api = inputs[0]?.json || {}; // this should be Google Places API response\nconst context = inputs[1]?.json || { page: 1, query: '' };\n\nconst query = context.query ?? '';\nconst page = context.page ?? 1;\nconst nextToken = api.next_page_token ?? null;\n\nlet placeIds = [];\n\n// ✅ Check if Google API results array exists and extract place_ids\nif (Array.isArray(api.results)) {\n  placeIds = api.results\n    .filter(place => place?.place_id)\n    .map(place => ({ place_id: place.place_id }));\n}\n\nconst output = [\n  {\n    json: {\n      query,\n      page,\n      placeIds: placeIds.length ? placeIds : [{ error: 'No valid place_id found in input 0' }]\n    }\n  }\n];\n\n// ✅ Add next page token if available\nif (nextToken && page < 3) {\n  output.push({\n    json: {\n      query,\n      page: page + 1,\n      nextPageToken: nextToken,\n      isNextPage: true\n    }\n  });\n}\n\nreturn output;\n"
      },
