    {
      "parameters": {
        "jsCode": "const rawText = $json.candidates?.[0]?.content?.parts?.[0]?.text || '';\n\n// Fallback-safe phrase block (no marker check — full extraction)\nconst phraseText = rawText.trim();\n\n// Split on commas — handle multiple lines, spacing, etc.\nconst searchPhrases = phraseText\n  .split(',')\n  .map(p => p.trim())\n  .filter(p => p.length > 0); // only ignore empty strings\n\n// Return ALL queries\nreturn searchPhrases.map(phrase => ({\n  json: {\n    query: phrase\n  }\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
