    {
      "parameters": {
        "jsCode": "const queries = $items(\"Set\").map(item => item.json.query || item.json);\nconst ctx = $json; // from context\nconst currentQuery = queries[ctx.index] || \"Unknown\";\n\nreturn [\n  {\n    json: {\n      query: currentQuery,\n      index: ctx.index,\n      results: ctx.results\n    }\n  }\n];\n"
