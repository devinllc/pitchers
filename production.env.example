# Production Environment Configuration
# Copy this file to .env.production and adjust values for your production environment

# =============================================================================
# CONCURRENCY CONFIGURATION
# =============================================================================

# Maximum concurrent jobs (ONLY configurable setting)
# Set this based on your server capacity - server handles RAM/CPU independently
# Recommended values:
# - Low resource servers: MAX_CONCURRENT_JOBS=1
# - Medium servers: MAX_CONCURRENT_JOBS=2-3
# - High resource servers: MAX_CONCURRENT_JOBS=4-5
MAX_CONCURRENT_JOBS=1

# Job timeout in minutes (optional - server default if not set)
JOB_TIMEOUT_MINUTES=30
MAX_CONCURRENT_JOBS=1

# =============================================================================
# SERVER MANAGEMENT
# =============================================================================

# Graceful shutdown timeout in seconds
GRACEFUL_SHUTDOWN_TIMEOUT=30

# Job cleanup interval in seconds (how often to clean up old jobs)
JOB_CLEANUP_INTERVAL=3600

# Memory monitoring (default enabled, set to false to disable)
ENABLE_MEMORY_MONITORING=true

# =============================================================================
# DEFAULT BEHAVIORS
# =============================================================================

# Note: The following settings use defaults:
# - Max Results Per Job: Set by client (no server limit)
# - Batch Size: Default Node.js behavior
# - Worker Memory: Default Node.js behavior
# - Memory Monitoring: Default enabled (can be disabled via env)

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pitchers_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Connection pool settings (adjust for your resources)
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Server port
PORT=3000

# API rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Gemini AI API
GEMINI_API_KEY=your_gemini_api_key

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Sheets (optional - will use mock mode if not provided)
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_OAUTH_JSON={"client_id":"...","client_secret":"...","refresh_token":"..."}

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOGGING=true

# Enable performance monitoring
ENABLE_PERFORMANCE_MONITORING=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT secret for API authentication
JWT_SECRET=your_jwt_secret_key

# CORS settings
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# =============================================================================
# PRODUCTION SPECIFIC SETTINGS
# =============================================================================

# Environment
NODE_ENV=production

# Enable compression
ENABLE_COMPRESSION=true

# Trust proxy (for load balancers)
TRUST_PROXY=true

# =============================================================================
# MONITORING & HEALTH CHECKS
# =============================================================================

# Health check endpoint
HEALTH_CHECK_ENABLED=true

# Metrics collection
METRICS_ENABLED=true

# =============================================================================
# EXAMPLE CONFIGURATIONS FOR DIFFERENT SERVER CAPACITIES
# =============================================================================

# LOW RESOURCE SERVERS
# MAX_CONCURRENT_JOBS=1
# JOB_TIMEOUT_MINUTES=30
# ENABLE_MEMORY_MONITORING=true

# MEDIUM SERVERS  
# MAX_CONCURRENT_JOBS=2
# JOB_TIMEOUT_MINUTES=30
# ENABLE_MEMORY_MONITORING=true

# HIGH RESOURCE SERVERS
# MAX_CONCURRENT_JOBS=4
# JOB_TIMEOUT_MINUTES=30
# ENABLE_MEMORY_MONITORING=true

# Note: 
# - Max Results Per Job: Set by client in API request
# - Batch Size: Default Node.js behavior
# - Worker Memory: Default Node.js behavior
# - Server handles RAM/CPU management independently
