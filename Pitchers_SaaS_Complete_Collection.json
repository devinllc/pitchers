						"body": {
							"mode": "raw",
							"raw": "{\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"id\": \"pay_1234567890\",\n      \"order_id\": \"order_1234567890\"\n    }\n  }\n}"
