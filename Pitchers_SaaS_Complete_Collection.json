{
	"info": {
		"_postman_id": "pitchers-saas-api-collection",
		"name": "Pitchers SaaS API - Complete Collection",
		"description": "Complete Postman collection for testing all 120+ endpoints in the Pitchers SaaS platform. Covers authentication, subscriptions, Google Sheets integration, job management, usage tracking, admin operations, and legacy APIs.",
